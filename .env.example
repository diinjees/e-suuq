# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# POCKETBASE_URL: PocketBase server endpoint (e.g. http://10.0.2.2:8090 for Android emulator accessing local host)
POCKETBASE_URL=http://10.0.2.2:8090

# POCKETBASE_USERNAME: Admin or User email/username for PocketBase authentication
POCKETBASE_USERNAME=admin@esuug.com

# POCKETBASE_PASSWORD: password for PocketBase authentication
POCKETBASE_PASSWORD=password123

